{
  "name": "open-dxp/perspective-editor-bundle",
  "license": "GPL-3.0+",
  "type": "opendxp-bundle",
  "description": "OpenDXP Perspective Editor",
  "config": {
    "sort-packages": true,
    "preferred-install": {
      "open-dxp/opendxp": "source",
      "*": "dist"
    }
  },
  "prefer-stable": true,
  "minimum-stability": "dev",
  "require": {
    "open-dxp/admin-bundle": "^1.0",
    "open-dxp/opendxp": "^1.0",
    "symfony/http-foundation": "^7.3"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.2",
    "phpunit/phpunit": "^9.3",
    "codeception/codeception": "^4.1.12 || ^5.0.3",
    "codeception/module-symfony":"^1.6.0 || ^3.1.0",
    "codeception/phpunit-wrapper": "^9",
    "codeception/module-asserts": "^2"
  },
  "autoload": {
    "psr-4": {
      "OpenDxp\\Bundle\\PerspectiveEditorBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OpenDxp\\Bundle\\PerspectiveEditorBundle\\Tests\\": "tests"
    },
    "files": [
      "kernel/Kernel.php"
    ]
  },
  "extra": {
    "opendxp": {
      "bundles": [
        "OpenDxp\\Bundle\\PerspectiveEditorBundle\\OpenDxpPerspectiveEditorBundle"
      ]
    }
  }
}
